{
  "info": {
    "name": "Restful Booker API Tests",
    "_postman_id": "6f1d3c2e-8a4b-4c55-9e1f-2b7a9d0c1e11",
    "description": "Automated API test suite for the public Restful Booker practice API (https://restful-booker.herokuapp.com).\n\nCovers health check, authentication, full booking CRUD, search, schema validation and negative cases (403 / 404 / bad credentials). Requests chain data through collection variables, so the whole collection runs end to end with the Collection Runner or Newman.\n\nAuthor: Davit Jikurashvili, Senior QA Automation Engineer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level checks that run after every request.",
          "pm.test('Response time is under 5s', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "token", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "firstname", "value": "" },
    { "key": "lastname", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Ping - API is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/ping", "host": ["{{baseUrl}}"], "path": ["ping"] }
          }
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Create token - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains a non-empty token', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.be.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth", "host": ["{{baseUrl}}"], "path": ["auth"] }
          }
        },
        {
          "name": "Create token - wrong password is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('No token is issued', () => {",
                  "    pm.expect(body).to.not.have.property('token');",
                  "});",
                  "",
                  "pm.test('Reason is \"Bad credentials\"', () => {",
                  "    pm.expect(body.reason).to.eql('Bad credentials');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth", "host": ["{{baseUrl}}"], "path": ["auth"] }
          }
        }
      ]
    },
    {
      "name": "03 Booking CRUD",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique guest name so the search test can find exactly this booking.",
                  "pm.collectionVariables.set('firstname', 'Davit');",
                  "pm.collectionVariables.set('lastname', 'QA-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['bookingid', 'booking'],",
                  "    properties: {",
                  "        bookingid: { type: 'integer' },",
                  "        booking: {",
                  "            type: 'object',",
                  "            required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "            properties: {",
                  "                firstname: { type: 'string' },",
                  "                lastname: { type: 'string' },",
                  "                totalprice: { type: 'integer' },",
                  "                depositpaid: { type: 'boolean' },",
                  "                bookingdates: {",
                  "                    type: 'object',",
                  "                    required: ['checkin', 'checkout'],",
                  "                    properties: {",
                  "                        checkin: { type: 'string' },",
                  "                        checkout: { type: 'string' }",
                  "                    }",
                  "                },",
                  "                additionalneeds: { type: 'string' }",
                  "            }",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Response matches the booking schema', () => {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Saved booking echoes the request data', () => {",
                  "    pm.expect(body.booking.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "    pm.expect(body.booking.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "    pm.expect(body.booking.totalprice).to.eql(250);",
                  "    pm.expect(body.booking.depositpaid).to.be.true;",
                  "    pm.expect(body.booking.bookingdates).to.eql({ checkin: '2026-11-01', checkout: '2026-11-05' });",
                  "});",
                  "",
                  "pm.collectionVariables.set('bookingId', body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 250,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/booking", "host": ["{{baseUrl}}"], "path": ["booking"] }
          }
        },
        {
          "name": "Get booking by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns the booking that was created', () => {",
                  "    pm.expect(body.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "    pm.expect(body.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "    pm.expect(body.additionalneeds).to.eql('Breakfast');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Search bookings by guest name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const ids = pm.response.json().map((b) => b.bookingid);",
                  "",
                  "pm.test('Search results include the new booking', () => {",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking"],
              "query": [
                { "key": "firstname", "value": "{{firstname}}" },
                { "key": "lastname", "value": "{{lastname}}" }
              ]
            }
          }
        },
        {
          "name": "Update booking (PUT) - full replace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('All fields are replaced', () => {",
                  "    pm.expect(body.firstname).to.eql('Updated');",
                  "    pm.expect(body.totalprice).to.eql(999);",
                  "    pm.expect(body.depositpaid).to.be.false;",
                  "    pm.expect(body.additionalneeds).to.eql('Dinner');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Cookie", "value": "token={{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Updated\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-03\"\n  },\n  \"additionalneeds\": \"Dinner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Update booking (PATCH) - partial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Patched fields change', () => {",
                  "    pm.expect(body.totalprice).to.eql(123);",
                  "    pm.expect(body.additionalneeds).to.eql('Late checkout');",
                  "});",
                  "",
                  "pm.test('Other fields keep their values from the PUT', () => {",
                  "    pm.expect(body.firstname).to.eql('Updated');",
                  "    pm.expect(body.depositpaid).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Cookie", "value": "token={{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalprice\": 123,\n  \"additionalneeds\": \"Late checkout\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Delete booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "token={{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Get deleted booking returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted booking is gone (404)', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04 Negative cases",
      "item": [
        {
          "name": "Update without token is forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403 Forbidden', () => {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"NoToken\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-02\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "1"]
            }
          }
        },
        {
          "name": "Delete with invalid token is forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403 Forbidden', () => {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "token=invalid-token-123" }],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "1"]
            }
          }
        },
        {
          "name": "Get non-existent booking returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 Not Found', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/booking/999999999",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "999999999"]
            }
          }
        },
        {
          "name": "Create booking with missing required fields is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request is not accepted (no 2xx)', () => {",
                  "    pm.expect(pm.response.code).to.not.be.within(200, 299);",
                  "});",
                  "",
                  "pm.test('No booking id is returned', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('bookingid');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"OnlyFirstName\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/booking", "host": ["{{baseUrl}}"], "path": ["booking"] }
          }
        }
      ]
    }
  ]
}
